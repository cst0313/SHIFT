# Required for live Gemini agent runs (kept strictly server-side)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model identifier (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Local API server port (defaults to 3001)
PORT=3001

# Optional: ElevenLabs API key for narrated demo video generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
